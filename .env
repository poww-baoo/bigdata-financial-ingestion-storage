# ============================================================================
# CẤU HÌNH MÔI TRƯỜNG DÙNG CHUNG CHO DỰ ÁN (INGESTION -> STORAGE)
# ============================================================================

# --- 1. APACHE KAFKA (Tầng Ingestion) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_TRANSACTIONS=financial_tx
KAFKA_TOPIC_DLQ=financial_tx_dlq
KAFKA_NUM_PARTITIONS=3

# --- 2. MINIO / S3 DATA LAKE (Tầng Storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_S3_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=financial-datalake

# --- 3. ĐƯỜNG DẪN TRONG DATA LAKE ---
LAKE_BRONZE_PATH=bronze/transactions
LAKE_QUARANTINE_PATH=quarantine/bad_transactions
LAKE_CHECKPOINT_PATH=checkpoints/transactions_stream_chk

# --- 4. CẤU HÌNH STREAMING & PRODUCER MẶC ĐỊNH ---
PRODUCER_DEFAULT_RATE=1000
PRODUCER_FAULT_RATE=0.02
PRODUCER_DUP_RATE=0.01
STREAM_TRIGGER_SECONDS=10
